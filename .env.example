# ─────────────────────────────────────────────────────────────────────────
# Baatasari Frontend (Next.js) — environment variables
#
# Copy this file to .env.local (local dev) or set each value in Vercel →
# Project → Settings → Environment Variables (production / preview).
#
# Note: any var prefixed with NEXT_PUBLIC_ is BAKED INTO THE CLIENT BUNDLE
# at build time — visible to anyone in the browser. Never put secrets
# behind that prefix.
# ─────────────────────────────────────────────────────────────────────────

# Backend API base URL. Always Cloudflare-proxied — never direct Hetzner.
NEXT_PUBLIC_API_URL=https://api.baatasari.com

# Public CDN / S3 base URLs for displaying user / event images. Should
# match the *_PUBLIC_BASE_URL values configured on the backend so the
# frontend can construct full image URLs from S3 object keys without
# round-tripping to the API.
NEXT_PUBLIC_AVATAR_BASE_URL=
NEXT_PUBLIC_EVENT_COVER_BASE_URL=

# Feature flags — both OPTIONAL.
# "1" to enable the admin UI bundle (organizer / admin dashboards).
# Leave unset on the public consumer build.
NEXT_PUBLIC_ADMIN=

# "1" to log auth-flow internals in the browser console. Useful while
# debugging OAuth / refresh-token issues. Never enable in production.
NEXT_PUBLIC_AUTH_DEBUG=
