# Frontend environment variables.
# Copy this file to `.env.local` and fill in real values. Do NOT commit `.env*`
# files containing real secrets — they are gitignored.

# ────────────────────────────────────────────────────────────────────────────
# Required
# ────────────────────────────────────────────────────────────────────────────

# Base URL of the Express backend, no trailing slash.
# Local dev:   http://localhost:3000
# Production:  https://api.your-domain.com
# IMPORTANT: this origin must be present in the backend's CORS_ORIGIN allowlist.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google OAuth client ID for "Continue with Google" on the auth pages.
# Get from Google Cloud Console → APIs & Services → Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Random URL-safe slug that gates the /admin/<slug>/... routes from being
# discoverable. Must match the slug that admin users visit. Rotate if leaked.
# Example: a 24-char base64url string.
NEXT_PUBLIC_ADMIN=

# ────────────────────────────────────────────────────────────────────────────
# Optional
# ────────────────────────────────────────────────────────────────────────────

# Public base URL where uploaded user/organizer avatars are served.
# Leave unset to use the default S3 public URL the backend returns.
NEXT_PUBLIC_AVATAR_BASE_URL=

# Public base URL where event cover images are served (CloudFront or S3 public).
NEXT_PUBLIC_EVENT_COVER_BASE_URL=

# Set to "true" to enable verbose auth-flow logs in the browser console.
# Use only in development.
NEXT_PUBLIC_AUTH_DEBUG=false
